# Copy to .env.local and adjust. Both are exposed to the browser (NEXT_PUBLIC_),
# so never put secrets here.

# Base URL of the Soko API (packages/server). Used by the browser and by
# server-rendered pages (product/category metadata, sitemap).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public URL this site is served from. Used for canonical links, Open Graph
# URLs, the sitemap and structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (no NEXT_PUBLIC_ prefix, never sent to browsers). Must match
# INTERNAL_API_KEY in packages/server/.env: page rendering then isn't
# rate-limited as a single client. At least 16 random characters, e.g.
#   openssl rand -hex 32
INTERNAL_API_KEY=
